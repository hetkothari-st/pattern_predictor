# Live price WebSocket. Leave empty to disable live ingest (use replay tool instead).
PRICE_WS_URL=
PRICE_WS_FORMAT=generic   # generic | binance | mt

DEFAULT_SYMBOL=BTCUSDT
DEFAULT_TIMEFRAME=1m

# --- MT Data Feed (PRICE_WS_FORMAT=mt) -------------------------------------
# URL: typically ws://115.242.15.134:19101 (or your own broker endpoint)
# Anonymous login works for market data; only set these for authenticated runs.
MT_LOGIN_ID=
MT_PASSWORD=
# JSON list of subscriptions. FeedType 1 = Index/Touchline, 2 = Depth (NSEFO/BSEFO).
# Symbol is the display name surfaced in the chart UI.
MT_SUBSCRIPTIONS=[{"Tkn":"26000","Xchg":"NSE","Symbol":"NIFTY50","FeedType":1},{"Tkn":"26009","Xchg":"NSE","Symbol":"NIFTYBANK","FeedType":1}]
