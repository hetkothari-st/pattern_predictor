# Live price WebSocket. Leave PRICE_WS_URL empty to disable live ingest
# (the replay tool still works for offline tests).
PRICE_WS_URL=ws://115.242.15.134:19101
PRICE_WS_FORMAT=mt        # generic | binance | mt

DEFAULT_SYMBOL=NIFTY50
DEFAULT_TIMEFRAME=1m

# --- MT Data Feed (PRICE_WS_FORMAT=mt) -------------------------------------
# Anonymous login works for market data; set these only for authenticated runs.
MT_LOGIN_ID=
MT_PASSWORD=
# JSON list of subscriptions. FeedType 1 = Index/Touchline, 2 = Depth (NSEFO/BSEFO).
# Symbol is the display name surfaced in the chart UI.
MT_SUBSCRIPTIONS=[{"Tkn":"26000","Xchg":"NSE","Symbol":"NIFTY50","FeedType":1},{"Tkn":"26009","Xchg":"NSE","Symbol":"NIFTYBANK","FeedType":1}]
# Optional: also record OHLCV bars to data/ohlcv/ as the engine builds them.
RECORD_OHLCV=true
